# ntfy topics are public to anyone who knows the name. Generate an unguessable one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(18))"
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Google Sheet push (`tracker sheet push`). Run `tracker sheet setup` for the
# full walkthrough. The id is the long string in the sheet URL — pasting the
# whole URL works too.
GOOGLE_SHEET_ID=
# Path to the service account JSON key, never the key itself. Keep it outside
# the repo and chmod 600 it.
GOOGLE_SHEET_CREDENTIALS=
