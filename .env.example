# ntfy topics are public to anyone who knows the name. Generate an unguessable one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(18))"
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Google Sheet push (`tracker sheet push`). Run `tracker sheet setup` for the
# full walkthrough. The id is the long string in the sheet URL — pasting the
# whole URL works too.
GOOGLE_SHEET_ID=
# Path to the service account JSON key, never the key itself. Keep it outside
# the repo and chmod 600 it.
GOOGLE_SHEET_CREDENTIALS=

# Gmail ingest (`tracker mail poll`). Run `tracker mail setup` for the
# walkthrough. Read-only: the scope requested is gmail.readonly, and nothing in
# this tool can send, label, archive or delete.
# Path to the OAuth *client* JSON (Desktop app), not a service account. One
# client covers every mailbox; run `tracker mail auth --account <label>` once
# per account and pick a different Google account in the browser each time.
GMAIL_CLIENT_SECRET=
# Directory holding the per-account refresh tokens (gmail-token-<label>.json).
# Defaults to ~/.config/tracker.
GMAIL_TOKEN_DIR=
