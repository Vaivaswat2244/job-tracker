[Unit]
Description=Poll watchlist ATS boards for new roles

StartLimitIntervalSec=3600
StartLimitBurst=10

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/projects/Tracker
ExecStartPre=/bin/sh -c 'i=0; while [ $i -lt 24 ]; do getent hosts boards-api.greenhouse.io >/dev/null 2>&1 && exit 0; i=$((i+1)); sleep 5; done; exit 0'
ExecStart=%h/Documents/projects/Tracker/bin/tracker poll

# A catch-up run fires the moment the laptop wakes, which races DNS coming back:
# network-online.target was already satisfied before the suspend, so it does not
# gate this. Without a retry the run just fails and the next one is a day away.
Restart=on-failure
RestartSec=120
